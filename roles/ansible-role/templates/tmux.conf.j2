# Managed by Ansible
# NOTE: Avoid manual edits if this file is fully managed by automation

##### TERMINAL & COLORS #####

# Enable true color support
# SUGGESTION: Consider using "tmux-256color" if available on your system
# It provides better feature detection than "screen-256color"
set -g default-terminal "screen-256color"

##### PANE SPLITTING KEY BINDINGS #####

# Change key bindings for splitting panes
unbind %
bind | split-window -h

unbind '"'
bind - split-window -v

# SUGGESTION: If you often split from the current path, consider:
# bind | split-window -h -c "#{pane_current_path}"
# bind - split-window -v -c "#{pane_current_path}"

##### PANE RESIZING #####

# Key bindings for resizing panes (repeatable with -r)
bind -r j resize-pane -D 5
bind -r k resize-pane -U 5
bind -r l resize-pane -R 5
bind -r h resize-pane -L 5

# SUGGESTION: You can reduce step size (e.g., 1 or 2) for finer control

##### PANE ZOOM #####

# Toggle pane zoom (maximize / restore)
bind -r m resize-pane -Z

##### MOUSE SUPPORT #####

# Enable mouse support in tmux
# NOTE: When enabled, Ctrl+C selection copying may conflict with terminal behavior
set -g mouse on

# SUGGESTION: For better copy behavior, consider using tmux-yank plugin

##### PLUGIN MANAGEMENT #####

# TPM (Tmux Plugin Manager)
set -g @plugin 'tmux-plugins/tpm'

# Theme plugins
# set -g @plugin 'egel/tmux-gruvbox'
# set -g @tmux-gruvbox 'dark'  # or 'light'
set -g @plugin 'fabioluciano/tmux-tokyo-night'

##### THEME CONFIGURATION #####

# Tokyo Night theme configuration
set -g @theme_variation 'moon'

# SUGGESTION: Available variations often include:
# storm | moon | night | day

##### SESSION MANAGEMENT #####

# Automatically save tmux sessions every 15 minutes
set -g @plugin 'tmux-plugins/tmux-continuum'

# SUGGESTION: Pair with tmux-resurrect for full session restoration
# set -g @plugin 'tmux-plugins/tmux-resurrect'

##### HISTORY & WINDOW BEHAVIOR #####

# Increase scrollback buffer size
set -g history-limit 10000

# Prevent applications from renaming windows
# Uncomment if window titles change unexpectedly
# set-option -g allow-rename off

##### STATUS BAR / POWERKIT #####

# Powerkit configuration
set -g @powerkit_keybinding_conflict_action skip
set -g @powerkit_plugins "battery,cpu,memory,datetime"

# Enable window index icons
set -g @powerkit_window_index_icons "true"

# SUGGESTION: Consider adding network or uptime modules if supported

##### WORKSPACE #####
set -g @plugin 'sainnhe/tmux-fzf'

##### TPM INITIALIZATION #####

# Initialize TPM
# IMPORTANT: This must remain at the very bottom of tmux.conf
run '~/.tmux/plugins/tpm/tpm'

